<!DOCTYPE html>

<head>
    <title>LojaVirtual: Cadastrar Produtos</title>
    <link rel="stylesheet" href="public/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
</head>

<body>
    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% produtos.forEach(p=> { %>
                <tr>
                    <td>
                        <%= p.nome %>
                    </td>
                    <td>R$ <%= p.preco %>
                    </td>
                    <td><a href="/pagina/produtos/<%= p.id %>">Ver Detalhes</a></td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    <% if (!produtos) { %>
        <p> Nenhum produto cadastrado. </p>
        <% }; %>
            <br>
            <a href="/">Voltar ao Início</a>
</body>

</html>